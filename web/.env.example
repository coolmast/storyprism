# Copy to web/.env (or web/.env.local) and fill in for a deployment that
# exposes this dev server through a reverse proxy under its own domain.
#
# Comma-separated hostnames Vite's dev server will accept a Host header
# for - required because Vite otherwise rejects any Host it doesn't
# recognize as localhost/LAN (see vite.config.js). Not needed for plain
# LAN access (http://<this-machine's-IP>:5174 already works).
ALLOWED_HOSTS=story.example.com
