# PhotoPrism instance this app reads photos from. Required.
PHOTOPRISM_BASE_URL=http://192.168.21.111:30234

# Only needed if that PhotoPrism instance requires login (its "password"
# auth mode) rather than running with auth off, e.g. someone else's own
# PhotoPrism rather than this app's original one. PHOTOPRISM_APP_PASSWORD
# is an "Application Password" created for that user in PhotoPrism's web UI
# (Account -> Application Passwords) - not their normal login password.
PHOTOPRISM_USERNAME=
PHOTOPRISM_APP_PASSWORD=
# Alternative to the two above: a pre-obtained session/access token, used
# as-is with no login request made.
PHOTOPRISM_API_TOKEN=

PORT=3001

# AI-assisted captions/research/interview. Leave blank to disable that part
# of the app (everything else still works without it).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Only needed for the "export to Saal Design Software" photobook feature:
# the local path Saal's own project files record for imported photos
# (~/Library/Application Support/SaalDesignSoftware/Local Store/projects/images/
# on the Mac that will import/print the generated project).
SAAL_IMAGE_URL_BASE=
